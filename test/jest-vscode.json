{
	"moduleFileExtensions": ["js", "json", "ts"],
	"rootDir": "..",
	"testEnvironment": "node",
	"testRegex": ".spec.ts$",
	"transform": {
		"^.+\\.(t|j)s$": ["@swc/jest"]
	},
	"moduleNameMapper": {
		"src/(.*)": "<rootDir>/src/$1"
	},
	"moduleDirectories": ["node_modules", "src"],
	"globalSetup": "<rootDir>/test/global-setup.ts",
	"globalTeardown": "<rootDir>/test/global-teardown.ts",
	"testTimeout": 90000
}
